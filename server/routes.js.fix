// This is the endpoint that needs to be fixed in server/routes.ts to get all commissions

app.get(`${apiPrefix}/commissions`, async (req, res) => {
  try {
    const limit = parseInt(req.query.limit as string) || 10;
    const offset = parseInt(req.query.offset as string) || 0;
    const status = req.query.status as string;
    const search = req.query.search as string;
    const date = req.query.date as string;
    
    // Modified query to get all commissions from the database
    const query = `
      SELECT 
        c.*, t.*, bp.*, o.*
      FROM 
        commissions c
      JOIN 
        transactions t ON c.transaction_id = t.id
      JOIN 
        benefit_programs bp ON t.benefit_program_id = bp.id
      JOIN 
        organizations o ON bp.organization_id = o.id
      ORDER BY 
        t.transaction_date DESC
      LIMIT $1 OFFSET $2
    `;
    
    const countQuery = `
      SELECT 
        COUNT(*) 
      FROM 
        commissions c
      JOIN 
        transactions t ON c.transaction_id = t.id
      JOIN 
        benefit_programs bp ON t.benefit_program_id = bp.id
      JOIN 
        organizations o ON bp.organization_id = o.id
    `;
    
    // Execute the queries directly against the database
    const [results, countResult] = await Promise.all([
      pool.query(query, [limit, offset]),
      pool.query(countQuery)
    ]);
    
    // Format the results
    const commissions = results.rows.map(row => {
      return {
        id: row.id,
        amount: row.amount,
        status: row.status,
        // ...other properties
        transaction: {
          // ...transaction properties
          benefitProgram: {
            // ...benefit program properties
            organization: {
              // ...organization properties
            }
          }
        }
      };
    });
    
    return res.json({
      data: commissions,
      meta: {
        total: parseInt(countResult.rows[0].count),
        limit,
        offset
      }
    });
  } catch (error) {
    console.error("Error getting commissions:", error);
    return res.status(500).json({ message: "Internal server error" });
  }
});
